{% extends 'base.html.twig' %}

{% block title %}Administration - Demandes de rendez-vous{% endblock %}

{% block body %}
    <div class="container">
        <div class="page-header">
            <h1>Demandes de rendez-vous</h1>
            <p>Validez une demande en l'affectant à un docteur, ou refusez-la pour la supprimer.</p>
        </div>

        <div class="card">
            <div class="card-head">
                <h2>{{ appointments|length }} demandes</h2>
                <form action="#" method="get" class="form-inline">
                    <label for="status">Filtrer&nbsp;:</label>
                    <select id="status" name="status">
                        <option value="">Toutes</option>
                        <option value="pending">En attente</option>
                        <option value="confirmed">Validées</option>
                    </select>
                    <button type="submit" class="btn btn-dark btn-sm">Appliquer</button>
                </form>
            </div>

            <div class="table-wrapper">
                <table class="table">
                    <thead>
                    <tr>
                        <th>Demande</th>
                        <th>Patient</th>
                        <th>Créneau souhaité</th>
                        <th>Motif</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for appointment in appointments %}
                        <tr>
                            <td>
                                <strong>#{{ appointment.id }}</strong>
                                <span class="muted">{{ appointment.date ? appointment.date|date('d/m/Y H:i') : '' }}</span>
                            </td>
                            <td>
                                {{ appointment.patientFirstName }} {{ appointment.patientName }}
                                <span class="muted">{{ appointment.patientMail }}</span>
                                <span class="muted">{{ appointment.patientPhoneNumber }}</span>
                            </td>
                            <td>{{ appointment.date ? appointment.date|date('l d/m/Y – H:i') : '' }}</td>
                            <td>{{ appointment.message ?: appointment.specialty ? appointment.specialty.name : '' }}</td>
                            <td>
                                {% if appointment.doctor %}
                                    <span class="badge badge-confirmed">Validée</span>
                                    <span class="muted">{{ appointment.doctor.getFullName() }}</span>
                                {% else %}
                                    <span class="badge badge-pending">En attente</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if not appointment.doctor %}
                                    <form action="{{ path('admin_appointment_assign', {'id': appointment.id}) }}" method="post" class="form-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('assign' ~ appointment.id) }}">
                                        <select name="doctor" aria-label="Affecter à un docteur">
                                            <option value="">Affecter à…</option>
                                            {% for doctor in doctors %}
                                                <option value="{{ doctor.id }}">{{ doctor.getFullName() }}</option>
                                            {% endfor %}
                                        </select>
                                        <button type="submit" class="btn btn-light btn-sm">Valider</button>
                                        <button type="submit" formaction="{{ path('admin_appointment_delete', {'id': appointment.id}) }}" class="btn btn-danger btn-sm" name="_delete">Refuser
                                        </button>
                                    </form>
                                {% else %}
                                    <form action="{{ path('admin_appointment_delete', {'id': appointment.id}) }}" method="post" class="form-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ appointment.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6">Aucune demande trouvée.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

