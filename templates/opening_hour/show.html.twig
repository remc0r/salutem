{% extends 'base.html.twig' %}

{% block title %}OpeningHour{% endblock %}

{% block body %}
    <h1>OpeningHour</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ opening_hour.id }}</td>
            </tr>
            <tr>
                <th>Day</th>
                <td>{{ opening_hour.day.value }}</td>
            </tr>
            <tr>
                <th>DayOrder</th>
                <td>{{ opening_hour.dayOrder }}</td>
            </tr>
            <tr>
                <th>OpensAt</th>
                <td>{{ opening_hour.opensAt ? opening_hour.opensAt|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>ClosesAt</th>
                <td>{{ opening_hour.closesAt ? opening_hour.closesAt|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>IsClosed</th>
                <td>{{ opening_hour.isClosed ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_opening_hours_index') }}">back to list</a>
{% endblock %}
